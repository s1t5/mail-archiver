@using MailArchiver.Services
@using MailArchiver.Services.Shared
@inject MailArchiver.Services.IAuthenticationService AuthService
@inject Microsoft.Extensions.Localization.IStringLocalizer<MailArchiver.SharedResource> Localizer
@model MailArchiver.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = Localizer["Dashboard"];
    var canManageAccounts = AuthService.IsCurrentUserAdmin(Context) || AuthService.IsCurrentUserSelfManager(Context);
    var currentUsername = AuthService.GetCurrentUserDisplayName(Context);

    // The charts are fed from a JSON island rather than from values written into the script,
    // both so that the first paint and every later selection run through one code path, and
    // because a sender address is a header value: an apostrophe in one would otherwise end the
    // string literal it was written into. The default serializer escapes the characters that
    // matter inside a script element.
    var chartPayload = new
    {
        granularity = Model.Series.Granularity,
        window = Model.Series.Window,
        senders = Model.Series.OutgoingSenders ? "outgoing" : "incoming",
        selectable = Model.SelectablePeriods,
        offset = Model.Series.Offset,
        canGoBack = Model.Series.CanGoBack,
        canGoForward = Model.Series.CanGoForward,
        rangeLabel = Model.Series.RangeLabel,
        labels = Model.Series.Emails.Select(e => e.Period),
        incoming = Model.Series.Emails.Select(e => e.Incoming),
        outgoing = Model.Series.Emails.Select(e => e.Outgoing),
        senderLabels = Model.Series.TopSenders.Select(s => s.EmailAddress),
        senderCounts = Model.Series.TopSenders.Select(s => s.Count),
        texts = new
        {
            incoming = Localizer["Incoming"].Value,
            outgoing = Localizer["Outgoing"].Value,
            loadFailed = Localizer["ChartLoadFailed"].Value
        }
    };
    var chartPayloadJson = System.Text.Json.JsonSerializer.Serialize(chartPayload);
}

@functions {
    /// <summary>
    /// Text of one window option: everything, or an amount with its unit in the singular or the
    /// plural.
    /// <para>
    /// The unit words have their own resource keys rather than sharing the ones the resolution
    /// menu uses, because a unit after a number is written differently per language: lower case
    /// in English, capitalised in German. Both spellings of the same word therefore have to be
    /// translatable separately.
    /// </para>
    /// </summary>
    private string WindowText(PeriodWindow window)
    {
        if (window.Unit == PeriodWindowUnit.Everything)
            return Localizer["All"].Value;

        var singular = window.Amount == 1;
        var unit = window.Unit switch
        {
            PeriodWindowUnit.Day => singular ? Localizer["PeriodUnitDay"] : Localizer["PeriodUnitDays"],
            PeriodWindowUnit.Month => singular ? Localizer["PeriodUnitMonth"] : Localizer["PeriodUnitMonths"],
            _ => singular ? Localizer["PeriodUnitYear"] : Localizer["PeriodUnitYears"]
        };

        return $"{window.Amount} {unit.Value}";
    }
}

<div class="container-fluid">
    <div class="dashboard-hero d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-2">
        <div>
            <h1 class="h3 mb-0">@Localizer["Dashboard"]</h1>
            @if (!string.IsNullOrEmpty(currentUsername))
            {
                <div class="hero-subtitle">@string.Format(Localizer["WelcomeBack"].Value, currentUsername)</div>
            }
        </div>
        <div>
            <a asp-controller="Emails" asp-action="Index" class="btn btn-primary btn-sm">
                <i class="bi bi-search"></i> <span class="d-none d-sm-inline">@Localizer["Search"]</span> @Localizer["Archive"]
            </a>
        </div>
    </div>

    @if (AuthService.IsCurrentUserAdmin(Context) && ViewBag.ActiveJobsCount != null && ViewBag.ActiveJobsCount > 0)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-info alert-dismissible fade show alert-persistent">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
                        <div>
                            <i class="bi bi-clock-history me-2"></i>
                            <strong>@Localizer["BackgroundJobsActive"]</strong> @string.Format(Localizer["BackgroundJobsActiveCount"].Value, ViewBag.ActiveJobsCount)
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <a asp-controller="Emails" asp-action="Jobs" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye me-1"></i> @Localizer["ViewJobs"]
                            </a>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row mb-4">
        <div class="col-6 col-md-3 mb-3">
            <div class="card stat-card-modern bg-primary text-white h-100">
                <div class="card-body">
                    <i class="bi bi-envelope stat-icon"></i>
                    <div class="stat-label">@Localizer["Emails"]</div>
                    <div class="stat-value" data-count-target="@Model.TotalEmails">@Model.TotalEmails.ToString("N0")</div>
                    @if (Model.ShowDirectionSplits)
                    {
                        <div class="stat-split">
                            <span title="@Localizer["Incoming"]"><i class="bi bi-arrow-down-left"></i> @Model.IncomingEmails.ToString("N0")</span>
                            <span title="@Localizer["Outgoing"]"><i class="bi bi-arrow-up-right"></i> @Model.OutgoingEmails.ToString("N0")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3 mb-3">
            <div class="card stat-card-modern bg-success text-white h-100">
                <div class="card-body">
                    <i class="bi bi-person-lines-fill stat-icon"></i>
                    <div class="stat-label">@Localizer["Accounts"]</div>
                    <div class="stat-value" data-count-target="@Model.TotalAccounts">@Model.TotalAccounts.ToString("N0")</div>
                    @if (Model.ShowDirectionSplits)
                    {
                        <div class="stat-split">
                            <span title="@Localizer["Domains"]"><i class="bi bi-globe2"></i> @Model.AccountDomains.ToString("N0") @Localizer["Domains"]</span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3 mb-3">
            <div class="card stat-card-modern bg-info text-white h-100">
                <div class="card-body">
                    <i class="bi bi-paperclip stat-icon"></i>
                    <div class="stat-label">@Localizer["AttachmentsCount"]</div>
                    <div class="stat-value" data-count-target="@Model.TotalAttachments">@Model.TotalAttachments.ToString("N0")</div>
                    @if (Model.ShowDirectionSplits)
                    {
                        <div class="stat-split">
                            <span title="@Localizer["Incoming"]"><i class="bi bi-arrow-down-left"></i> @Model.IncomingAttachments.ToString("N0")</span>
                            <span title="@Localizer["Outgoing"]"><i class="bi bi-arrow-up-right"></i> @Model.OutgoingAttachments.ToString("N0")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3 mb-3">
            <div class="card stat-card-modern bg-warning text-dark h-100">
                <div class="card-body">
                    <i class="bi bi-hdd stat-icon"></i>
                    <div class="stat-label">@Localizer["DatabaseStorage"]</div>
                    <div class="stat-value">@Model.TotalStorageUsed</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12 col-lg-8 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center@(Model.SelectablePeriods ? " flex-wrap gap-2" : "")">
                    <span class="h6 mb-0"><i class="bi bi-bar-chart me-1"></i>@(Model.SelectablePeriods ? Localizer["EmailsPerPeriod"] : Localizer["EmailsPerMonth"])</span>
                    @if (!Model.SelectablePeriods)
                    {
                        <span class="badge bg-primary">@Localizer["Last12Months"]</span>
                    }
                    else
                    {
                    <div class="dashboard-chart-controls">
                        @* Deliberately not a btn-group: that class is turned into a vertical
                           stack below 768px further up site.css, which would put the two arrows
                           on top of each other. *@
                        <div class="dashboard-chart-pager" role="group">
                            <button type="button" id="chartEarlier" class="btn btn-sm btn-outline-secondary"
                                    aria-label="@Localizer["EarlierPeriod"]" title="@Localizer["EarlierPeriod"]"
                                    disabled="@(!Model.Series.CanGoBack)">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <button type="button" id="chartLater" class="btn btn-sm btn-outline-secondary"
                                    aria-label="@Localizer["LaterPeriod"]" title="@Localizer["LaterPeriod"]"
                                    disabled="@(!Model.Series.CanGoForward)">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                        <span id="chartRange" class="dashboard-chart-range">@Model.Series.RangeLabel</span>
                        <button type="button" id="chartNow" class="btn btn-sm btn-link p-0"
                                hidden="@(Model.Series.Offset == 0)">@Localizer["CurrentPeriod"]</button>
                        <select id="chartGranularity" class="form-select form-select-sm"
                                aria-label="@Localizer["ChartGranularity"]" title="@Localizer["ChartGranularity"]">
                            @foreach (var granularity in DashboardPeriods.Granularities)
                            {
                                <option value="@granularity" selected="@(granularity.ToString() == Model.Series.Granularity)">
                                    @Localizer[granularity.ToString()]
                                </option>
                            }
                        </select>
                        <select id="chartWindow" class="form-select form-select-sm"
                                aria-label="@Localizer["Period"]" title="@Localizer["Period"]">
                            @foreach (var window in DashboardPeriods.Windows)
                            {
                                var offeredBy = string.Join(" ", DashboardPeriods.Granularities
                                    .Where(g => DashboardPeriods.IsOffered(g, window)));
                                <option value="@window.Key" data-granularities="@offeredBy"
                                        selected="@(window.Key == Model.Series.Window)">
                                    @WindowText(window)
                                </option>
                            }
                        </select>
                    </div>
                    }
                </div>
                <div class="card-body dashboard-chart-body">
                    <div class="chart-container">
                        <canvas id="monthlyChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center@(Model.SelectablePeriods ? " flex-wrap gap-2" : "")">
                    <span class="h6 mb-0"><i class="bi bi-pie-chart me-1"></i>@Localizer["TopSenders"]</span>
                    @if (!Model.SelectablePeriods)
                    {
                        <span class="badge bg-primary">@Localizer["Incoming"]</span>
                    }
                    else
                    {
                        <div class="dashboard-chart-controls">
                            <select id="chartSenders" class="form-select form-select-sm"
                                    aria-label="@Localizer["Direction"]" title="@Localizer["Direction"]">
                                <option value="incoming" selected="@(!Model.Series.OutgoingSenders)">@Localizer["Incoming"]</option>
                                <option value="outgoing" selected="@Model.Series.OutgoingSenders">@Localizer["Outgoing"]</option>
                            </select>
                        </div>
                    }
                </div>
                <div class="card-body dashboard-chart-body">
                    <div class="chart-container">
                        <canvas id="topSendersChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        @if (Model.SelectablePeriods)
        {
            <div class="col-12">
                <div id="chartLoadError" class="alert alert-warning py-2 mb-4 small" role="status" hidden></div>
            </div>
        }
    </div>

    <div class="row">
        <div class="col-12 col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="h6 mb-0"><i class="bi bi-list-ul me-1"></i>@Localizer["AccountOverview"]</span>
                    <a asp-controller="MailAccounts" asp-action="Index" class="btn btn-sm btn-outline-primary">@Localizer["ShowAll"]</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive d-none d-md-block">
                        <table class="table table-sm table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>@Localizer["Name"]</th>
                                    <th class="d-none d-lg-table-cell">@Localizer["EmailAddress"]</th>
                                    <th>@Localizer["Count"]</th>
                                    <th>@Localizer["Storage"]</th>
                                    <th>@Localizer["LastSync"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var account in Model.EmailsPerAccount)
                                {
                                    <tr>
                                        <td>
                                            @if (canManageAccounts)
                                            {
                                                <a asp-controller="MailAccounts" asp-action="Details" asp-route-id="@account.AccountId" class="text-decoration-none">@account.AccountName</a>
                                            }
                                            else
                                            {
                                                @account.AccountName
                                            }
                                        </td>
                                        <td class="d-none d-lg-table-cell small text-truncate" style="max-width: 200px;">@account.EmailAddress</td>
                                        <td>@account.EmailCount.ToString("N0")</td>
                                        <td class="small text-nowrap">@account.StorageUsed</td>
                                        <td>
                                            @if (account.IsSyncing)
                                            {
                                                <span class="badge bg-primary small">
                                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width:0.7em;height:0.7em;"></span>
                                                    @Localizer["SyncRunning"]
                                                </span>
                                            }
                                            else if (account.IsSyncPending)
                                            {
                                                <span class="badge bg-secondary small">@Localizer["SyncPending"]</span>
                                            }
                                            else if (account.Provider == ProviderType.IMPORT)
                                            {
                                                <span class="badge bg-light text-dark small">@Localizer["Never"]</span>
                                            }
                                            else if (DateTime.Now.Subtract(account.LastSyncTime).TotalHours < 24)
                                            {
                                                <span class="badge bg-success small">
                                                    <span class="utc-timestamp" data-utc-time="@account.LastSyncTime.ToString("yyyy-MM-ddTHH:mm:ss")">
                                                        @account.LastSyncTime.ToString("g")
                                                    </span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning small">
                                                    <span class="utc-timestamp" data-utc-time="@account.LastSyncTime.ToString("yyyy-MM-ddTHH:mm:ss")">
                                                        @account.LastSyncTime.ToString("g")
                                                    </span>
                                                </span>
                                            }
                                            @if (account.LastRunHadIssues)
                                            {
                                                if (canManageAccounts)
                                                {
                                                    <a asp-controller="MailAccounts" asp-action="Details" asp-route-id="@account.AccountId"
                                                       class="ms-1 text-warning text-decoration-none"
                                                       title="@Localizer["LastRunHadIssuesHint"]">
                                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-exclamation-triangle-fill text-warning ms-1"
                                                       title="@Localizer["LastRunHadIssuesHint"]"></i>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (!Model.EmailsPerAccount.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center dashboard-empty-state text-muted">
                                            <i class="bi bi-inbox empty-icon"></i>
                                            <div class="empty-text">@Localizer["NoEmailAccountsFound"]</div>
                                            @if (canManageAccounts)
                                            {
                                                <div class="mt-3">
                                                    <a asp-controller="MailAccounts" asp-action="Create" class="btn btn-sm btn-outline-primary">
                                                        <i class="bi bi-plus-circle"></i> @Localizer["AddAccount"]
                                                    </a>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-md-none">
                        @foreach (var account in Model.EmailsPerAccount)
                        {
                            <div class="border-bottom px-3 py-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">
                                            @if (canManageAccounts)
                                            {
                                                <a asp-controller="MailAccounts" asp-action="Details" asp-route-id="@account.AccountId" class="text-decoration-none">@account.AccountName</a>
                                            }
                                            else
                                            {
                                                @account.AccountName
                                            }
                                        </h6>
                                        <p class="mb-1 small text-muted text-truncate">@account.EmailAddress</p>
                                        <p class="mb-0 small">
                                            <strong>@account.EmailCount.ToString("N0")</strong> @Localizer["Emails"]
                                            <span class="text-muted">·</span> <span class="text-nowrap">@account.StorageUsed</span>
                                        </p>
                                    </div>
                                    <div class="text-end">
                                        @if (account.IsSyncing)
                                        {
                                            <span class="badge bg-primary">
                                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width:0.7em;height:0.7em;"></span>
                                                @Localizer["SyncRunning"]
                                            </span>
                                        }
                                        else if (account.IsSyncPending)
                                        {
                                            <span class="badge bg-secondary">@Localizer["SyncPending"]</span>
                                        }
                                        else if (account.Provider == ProviderType.IMPORT)
                                        {
                                            <span class="badge bg-light text-dark">@Localizer["Never"]</span>
                                        }
                                        else if (DateTime.Now.Subtract(account.LastSyncTime).TotalHours < 24)
                                        {
                                            <span class="badge bg-success">
                                                <span class="utc-timestamp" data-utc-time="@account.LastSyncTime.ToString("yyyy-MM-ddTHH:mm:ss")">
                                                    @account.LastSyncTime.ToString("g")
                                                </span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">
                                                <span class="utc-timestamp" data-utc-time="@account.LastSyncTime.ToString("yyyy-MM-ddTHH:mm:ss")">
                                                    @account.LastSyncTime.ToString("g")
                                                </span>
                                            </span>
                                        }
                                        @if (account.LastRunHadIssues)
                                        {
                                            if (canManageAccounts)
                                            {
                                                <a asp-controller="MailAccounts" asp-action="Details" asp-route-id="@account.AccountId"
                                                   class="ms-1 text-warning text-decoration-none"
                                                   title="@Localizer["LastRunHadIssuesHint"]">
                                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <i class="bi bi-exclamation-triangle-fill text-warning ms-1"
                                                   title="@Localizer["LastRunHadIssuesHint"]"></i>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        @if (!Model.EmailsPerAccount.Any())
                        {
                            <div class="text-center dashboard-empty-state text-muted">
                                <i class="bi bi-inbox empty-icon"></i>
                                <div class="empty-text">@Localizer["NoEmailAccountsFound"]</div>
                                @if (canManageAccounts)
                                {
                                    <a asp-controller="MailAccounts" asp-action="Create" class="btn btn-sm btn-outline-primary mt-3">
                                        <i class="bi bi-plus-circle"></i> @Localizer["AddAccount"]
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="h6 mb-0"><i class="bi bi-clock-history me-1"></i>@Localizer["RecentEmails"]</span>
                    <a asp-controller="Emails" asp-action="Index" class="btn btn-sm btn-outline-primary">@Localizer["ShowAll"]</a>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var email in Model.RecentEmails)
                        {
                            <a href="@Url.Action("Details", "Emails", new { id = email.Id })" class="list-group-item list-group-item-action recent-email-item">
                                <div class="d-flex w-100 justify-content-between align-items-start">
                                    <div class="d-flex align-items-start flex-grow-1 flex-min-0 me-2">
                                        <div class="avatar-initial me-2" data-sender="@email.From"></div>
                                        <div class="flex-grow-1 flex-min-0">
                                            <h6 class="mb-1 text-truncate">
                                                <span class="direction-dot @(email.IsOutgoing ? "outgoing" : "incoming")"></span>
                                                @email.Subject
                                            </h6>
                                            <p class="mb-1 small text-truncate text-muted">@email.From</p>
                                            <small class="text-muted">
                                                <i class="bi bi-person me-1"></i>@email.MailAccountName
                                            </small>
                                        </div>
                                    </div>
                                    <div class="text-end text-nowrap">
                                        <small class="text-muted">
                                            @email.SentDate.ToString("g")
                                        </small>
                                    </div>
                                </div>
                            </a>
                        }
                        @if (!Model.RecentEmails.Any())
                        {
                            <div class="list-group-item text-center dashboard-empty-state text-muted">
                                <i class="bi bi-inbox empty-icon"></i>
                                <div class="empty-text">@Localizer["NoEmailsArchivedYet"]</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-lightning me-1"></i>@Localizer["QuickActions"]</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <a asp-controller="Emails" asp-action="Index" class="action-card action-primary">
                                <div class="action-icon-circle">
                                    <i class="bi bi-search"></i>
                                </div>
                                <div class="action-label">@Localizer["SearchArchive"]</div>
                            </a>
                        </div>
                        @if (canManageAccounts)
                        {
                            <div class="col-6 col-md-3">
                                <a asp-controller="MailAccounts" asp-action="Create" class="action-card action-success">
                                    <div class="action-icon-circle">
                                        <i class="bi bi-plus-circle"></i>
                                    </div>
                                    <div class="action-label">@Localizer["AddAccount"]</div>
                                </a>
                            </div>
                            <div class="col-6 col-md-3">
                                <a asp-controller="MailAccounts" asp-action="Index" class="action-card action-info">
                                    <div class="action-icon-circle">
                                        <i class="bi bi-person-gear"></i>
                                    </div>
                                    <div class="action-label">@Localizer["ManageAccounts"]</div>
                                </a>
                            </div>
                        }
                        @if (AuthService.IsCurrentUserAdmin(Context))
                        {
                            <div class="col-6 col-md-3">
                                <a asp-controller="Emails" asp-action="Jobs" class="action-card action-warning position-relative">
                                    <div class="action-icon-circle">
                                        <i class="bi bi-clock-history"></i>
                                    </div>
                                    <div class="action-label">@Localizer["BackgroundJobs"]</div>
                                    @if (ViewBag.ActiveJobsCount != null && ViewBag.ActiveJobsCount > 0)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                            @ViewBag.ActiveJobsCount
                                            <span class="visually-hidden">@Localizer["ActiveJobs"]</span>
                                        </span>
                                    }
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
     <script src="~/lib/chart.js/chart.js"></script>
    <script type="application/json" id="dashboard-chart-data">@Html.Raw(chartPayloadJson)</script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            // --- Count-up animation for stat cards ---
            function animateCount(el, target, duration) {
                const start = 0;
                const startTime = performance.now();
                function update(now) {
                    const elapsed = now - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    const current = Math.floor(start + (target - start) * eased);
                    el.textContent = current.toLocaleString();
                    if (progress < 1) requestAnimationFrame(update);
                    else el.textContent = target.toLocaleString();
                }
                requestAnimationFrame(update);
            }

            if (!prefersReducedMotion) {
                document.querySelectorAll('.stat-value[data-count-target]').forEach(el => {
                    const target = parseInt(el.dataset.countTarget, 10);
                    if (target > 0) el.textContent = '0';
                });

                const observer = new IntersectionObserver((entries, obs) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const el = entry.target;
                            const target = parseInt(el.dataset.countTarget, 10);
                            if (target > 0) animateCount(el, target, 1200);
                            obs.unobserve(el);
                        }
                    });
                }, { threshold: 0.3 });

                document.querySelectorAll('.stat-value[data-count-target]').forEach(el => {
                    const target = parseInt(el.dataset.countTarget, 10);
                    if (target > 0) observer.observe(el);
                });
            }

            // --- Avatar initials for recent emails ---
            function getInitial(name) {
                if (!name) return '?';
                const cleanName = name.replace(/^.*<(.+)>$/, '$1').trim();
                return cleanName.charAt(0).toUpperCase();
            }

            function getColorIndex(name) {
                let hash = 0;
                for (let i = 0; i < name.length; i++) {
                    hash = name.charCodeAt(i) + ((hash << 5) - hash);
                }
                return Math.abs(hash) % 8;
            }

            document.querySelectorAll('.avatar-initial[data-sender]').forEach(el => {
                const sender = el.dataset.sender || '';
                el.textContent = getInitial(sender);
                el.classList.add('avatar-color-' + getColorIndex(sender));
            });

            // --- Relative date formatting ---
            function formatRelativeTime(utcString) {
                if (!utcString) return '';
                const date = new Date(utcString + (utcString.endsWith('Z') ? '' : 'Z'));
                if (isNaN(date.getTime())) return '';
                const now = new Date();
                const diffMs = now - date;
                const diffMin = Math.floor(diffMs / 60000);
                const diffHr = Math.floor(diffMin / 60);
                const diffDay = Math.floor(diffHr / 24);

                const lang = document.documentElement.lang || 'en';

                if (diffMin < 1) return '';
                if (diffMin < 60) {
                    const templates = { 'de': 'vor {0} Min.', 'en': '{0} min ago', 'fr': 'il y a {0} min', 'es': 'hace {0} min', 'it': '{0} min fa', 'nl': '{0} min geleden', 'pl': '{0} min temu', 'ru': '{0} мин назад', 'hu': '{0} perce', 'sl': 'pred {0} min' };
                    const tpl = templates[lang] || templates['en'];
                    return tpl.replace('{0}', diffMin);
                }
                if (diffHr < 24) {
                    const templates = { 'de': 'vor {0} Std.', 'en': '{0}h ago', 'fr': 'il y a {0}h', 'es': 'hace {0}h', 'it': '{0}h fa', 'nl': '{0}u geleden', 'pl': '{0} godz. temu', 'ru': '{0} ч назад', 'hu': '{0} órája', 'sl': 'pred {0} h' };
                    const tpl = templates[lang] || templates['en'];
                    return tpl.replace('{0}', diffHr);
                }
                if (diffDay < 30) {
                    const templates = { 'de': 'vor {0} Tag(en)', 'en': '{0}d ago', 'fr': 'il y a {0}j', 'es': 'hace {0}d', 'it': '{0}g fa', 'nl': '{0}d geleden', 'pl': '{0} dni temu', 'ru': '{0} д назад', 'hu': '{0} napja', 'sl': 'pred {0} dni' };
                    const tpl = templates[lang] || templates['en'];
                    return tpl.replace('{0}', diffDay);
                }
                return '';
            }

            document.querySelectorAll('.relative-date[data-utc-time]').forEach(el => {
                el.textContent = formatRelativeTime(el.dataset.utcTime);
            });

            // --- Charts ---
            const chartColors = {
                blue: 'rgba(13, 110, 253, 0.8)',
                blueBorder: 'rgba(13, 110, 253, 1)',
                // Same pairing the archive list uses for a message's direction: green arrived,
                // blue was sent.
                green: 'rgba(25, 135, 84, 0.8)',
                greenBorder: 'rgba(25, 135, 84, 1)',
                colors: [
                    'rgba(220, 53, 69, 0.8)',
                    'rgba(13, 110, 253, 0.8)',
                    'rgba(255, 193, 7, 0.8)',
                    'rgba(25, 135, 84, 0.8)',
                    'rgba(102, 16, 242, 0.8)',
                    'rgba(253, 126, 20, 0.8)',
                    'rgba(111, 66, 193, 0.8)',
                    'rgba(214, 51, 132, 0.8)',
                    'rgba(32, 201, 151, 0.8)',
                    'rgba(111, 66, 193, 0.8)'
                ],
                colorsBorder: [
                    'rgba(220, 53, 69, 1)',
                    'rgba(13, 110, 253, 1)',
                    'rgba(255, 193, 7, 1)',
                    'rgba(25, 135, 84, 1)',
                    'rgba(102, 16, 242, 1)',
                    'rgba(253, 126, 20, 1)',
                    'rgba(111, 66, 193, 1)',
                    'rgba(214, 51, 132, 1)',
                    'rgba(32, 201, 151, 1)',
                    'rgba(111, 66, 193, 1)'
                ]
            };

            // --- Chart Dark Mode Theme ---
            function getChartTheme() {
                const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                return {
                    textColor: isDark ? '#e2e8f0' : '#495057',
                    gridColor: isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.05)',
                    tooltipBg: isDark ? '#2d3748' : '#ffffff',
                    tooltipTitleColor: isDark ? '#e2e8f0' : '#1a1a1a',
                    tooltipBodyColor: isDark ? '#e2e8f0' : '#495057',
                    tooltipBorderColor: isDark ? '#4a5568' : 'rgba(0, 0, 0, 0.1)'
                };
            }

            function applyChartTheme(chart) {
                if (!chart) return;
                const t = getChartTheme();
                if (chart.options.scales) {
                    if (chart.options.scales.x && chart.options.scales.x.ticks) {
                        chart.options.scales.x.ticks.color = t.textColor;
                    }
                    if (chart.options.scales.y && chart.options.scales.y.ticks) {
                        chart.options.scales.y.ticks.color = t.textColor;
                    }
                    if (chart.options.scales.y && chart.options.scales.y.grid) {
                        chart.options.scales.y.grid.color = t.gridColor;
                    }
                }
                if (chart.options.plugins && chart.options.plugins.legend && chart.options.plugins.legend.labels) {
                    chart.options.plugins.legend.labels.color = t.textColor;
                }
                if (chart.options.plugins && chart.options.plugins.tooltip) {
                    const tt = chart.options.plugins.tooltip;
                    tt.backgroundColor = t.tooltipBg;
                    tt.titleColor = t.tooltipTitleColor;
                    tt.bodyColor = t.tooltipBodyColor;
                    tt.borderColor = t.tooltipBorderColor;
                }
                chart.update('none');
            }

            const chartTheme = getChartTheme();
            let monthlyChartInstance = null;
            let topSendersChartInstance = null;

            // Everything the charts need comes from the island and from the two selects. Read
            // here, at the top of the section, and not while wiring up a handler: a const
            // declared further down is in its temporal dead zone until then, and touching it
            // early throws without anything on the page looking wrong.
            const chartDataElement = document.getElementById('dashboard-chart-data');
            const chartDataUrl = '@Url.Action("ChartData", "Home")';
            const granularitySelect = document.getElementById('chartGranularity');
            const windowSelect = document.getElementById('chartWindow');
            const sendersSelect = document.getElementById('chartSenders');
            const earlierButton = document.getElementById('chartEarlier');
            const laterButton = document.getElementById('chartLater');
            const nowButton = document.getElementById('chartNow');
            const rangeLabel = document.getElementById('chartRange');
            const chartBodies = Array.prototype.slice.call(document.querySelectorAll('.dashboard-chart-body'));

            // Whole windows into the past, zero being the one holding the current instant. The
            // server owns this number: it pulls a position past the oldest mail back to the
            // furthest one that holds any, and every answer says which position it used.
            let chartOffset = 0;

            let chartData = null;
            if (chartDataElement) {
                try {
                    chartData = JSON.parse(chartDataElement.textContent);
                } catch (e) {
                    chartData = null;
                }
            }

            const senderLabelMaxLength = 25;
            function shortenAddress(address) {
                const value = address || '';
                return value.length > senderLabelMaxLength
                    ? value.substring(0, senderLabelMaxLength) + '...'
                    : value;
            }

            function setChartsBusy(busy) {
                chartBodies.forEach(body => body.classList.toggle('is-busy', busy));
            }

            function showChartError(message) {
                const holder = document.getElementById('chartLoadError');
                if (!holder) return;
                holder.textContent = message || '';
                holder.hidden = !message;
            }

            if (chartData) {
                const monthlyChartCanvas = document.getElementById('monthlyChart');
                if (monthlyChartCanvas) {
                    monthlyChartInstance = new Chart(monthlyChartCanvas.getContext('2d'), {
                        type: 'bar',
                        // With fixed periods the chart is the one series it was before the
                        // pickers existed: the split belongs to the same package as the legend
                        // and the two colours.
                        data: {
                            labels: chartData.labels,
                            datasets: chartData.selectable
                                ? [
                                    {
                                        label: chartData.texts.incoming,
                                        data: chartData.incoming,
                                        backgroundColor: chartColors.green,
                                        borderColor: chartColors.greenBorder,
                                        borderWidth: 1,
                                        borderRadius: 4,
                                        stack: 'mail'
                                    },
                                    {
                                        label: chartData.texts.outgoing,
                                        data: chartData.outgoing,
                                        backgroundColor: chartColors.blue,
                                        borderColor: chartColors.blueBorder,
                                        borderWidth: 1,
                                        borderRadius: 4,
                                        stack: 'mail'
                                    }
                                ]
                                : [{
                                    label: 'Emails',
                                    data: chartData.incoming.map((value, i) => value + chartData.outgoing[i]),
                                    backgroundColor: chartColors.blue,
                                    borderColor: chartColors.blueBorder,
                                    borderWidth: 1,
                                    borderRadius: 4
                                }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            animation: prefersReducedMotion ? false : { duration: 800, easing: 'easeOutCubic' },
                            plugins: {
                                legend: {
                                    display: chartData.selectable,
                                    position: 'bottom',
                                    labels: {
                                        boxWidth: 12,
                                        color: chartTheme.textColor,
                                        font: { size: window.innerWidth < 768 ? 9 : 11 }
                                    }
                                },
                                tooltip: {
                                    backgroundColor: chartTheme.tooltipBg,
                                    titleColor: chartTheme.tooltipTitleColor,
                                    bodyColor: chartTheme.tooltipBodyColor,
                                    borderColor: chartTheme.tooltipBorderColor
                                }
                            },
                            scales: {
                                x: {
                                    stacked: chartData.selectable,
                                    ticks: {
                                        maxRotation: 45,
                                        minRotation: 0,
                                        color: chartTheme.textColor,
                                        font: { size: window.innerWidth < 768 ? 10 : 12 }
                                    },
                                    grid: { display: false }
                                },
                                y: {
                                    stacked: chartData.selectable,
                                    beginAtZero: true,
                                    ticks: {
                                        precision: 0,
                                        color: chartTheme.textColor,
                                        font: { size: window.innerWidth < 768 ? 10 : 12 }
                                    },
                                    grid: { color: chartTheme.gridColor }
                                }
                            }
                        }
                    });
                }

                const topSendersChartCanvas = document.getElementById('topSendersChart');
                if (topSendersChartCanvas) {
                    topSendersChartInstance = new Chart(topSendersChartCanvas.getContext('2d'), {
                        type: 'doughnut',
                        data: {
                            labels: chartData.senderLabels.map(shortenAddress),
                            datasets: [{
                                data: chartData.senderCounts,
                                backgroundColor: chartColors.colors,
                                borderColor: chartColors.colorsBorder,
                                borderWidth: 1,
                                hoverOffset: 4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            animation: prefersReducedMotion ? false : { duration: 800, easing: 'easeOutCubic' },
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: {
                                        boxWidth: 12,
                                        color: chartTheme.textColor,
                                        font: { size: window.innerWidth < 768 ? 9 : 11 },
                                        padding: window.innerWidth < 768 ? 10 : 15
                                    }
                                },
                                tooltip: {
                                    backgroundColor: chartTheme.tooltipBg,
                                    titleColor: chartTheme.tooltipTitleColor,
                                    bodyColor: chartTheme.tooltipBodyColor,
                                    borderColor: chartTheme.tooltipBorderColor,
                                    callbacks: {
                                        label: function(context) {
                                            // The legend shows the address shortened, the tooltip
                                            // shows what it was shortened from.
                                            const full = context.chart.fullSenderLabels || [];
                                            let label = full[context.dataIndex] || context.label || '';
                                            let value = context.parsed || 0;
                                            let total = context.dataset.data.reduce((a, b) => a + b, 0);
                                            let percentage = total > 0 ? Math.round((value * 100) / total) : 0;
                                            return `${label}: ${value} (${percentage}%)`;
                                        }
                                    }
                                }
                            }
                        }
                    });
                    topSendersChartInstance.fullSenderLabels = chartData.senderLabels;
                }
            }

            // The server decides which pairs of resolution and window are worth drawing, and it
            // answers with the pair it actually used. The selects follow that answer instead of
            // what they were set to, so a resolution that does not offer the chosen window
            // cannot leave the page claiming something the chart does not show.
            function syncChartSelects(data) {
                if (granularitySelect && data.granularity) granularitySelect.value = data.granularity;
                if (windowSelect && data.window) windowSelect.value = data.window;
                if (sendersSelect && data.senders) sendersSelect.value = data.senders;
            }

            // Where the paging controls get their state: from the answer, never from counting
            // along locally. How far back there is mail is something only the server knows.
            function syncChartPaging(data) {
                chartOffset = typeof data.offset === 'number' ? data.offset : 0;
                if (earlierButton) earlierButton.disabled = !data.canGoBack;
                if (laterButton) laterButton.disabled = !data.canGoForward;
                if (nowButton) nowButton.hidden = chartOffset === 0;
                if (rangeLabel) rangeLabel.textContent = data.rangeLabel || '';
            }

            function offerWindowsFor(granularity) {
                if (!windowSelect) return;

                const options = Array.prototype.slice.call(windowSelect.options);
                options.forEach(option => {
                    const offeredBy = (option.dataset.granularities || '').split(' ');
                    option.hidden = offeredBy.indexOf(granularity) === -1;
                    option.disabled = option.hidden;
                });

                const selected = windowSelect.selectedOptions[0];
                if (selected && !selected.hidden) return;

                // Nothing on offer at the chosen window: move to the nearest one that is, by
                // position in the menu, so months to hours lands on the longest hour window.
                const position = options.indexOf(selected);
                const candidates = options
                    .filter(option => !option.hidden)
                    .sort((a, b) => Math.abs(options.indexOf(a) - position) - Math.abs(options.indexOf(b) - position));
                if (candidates.length > 0) windowSelect.value = candidates[0].value;
            }

            function applyChartSeries(data) {
                chartData = Object.assign({}, data, { texts: chartData ? chartData.texts : data.texts });

                if (monthlyChartInstance) {
                    monthlyChartInstance.data.labels = data.labels;
                    if (monthlyChartInstance.data.datasets.length > 1) {
                        monthlyChartInstance.data.datasets[0].data = data.incoming;
                        monthlyChartInstance.data.datasets[1].data = data.outgoing;
                    } else {
                        monthlyChartInstance.data.datasets[0].data =
                            data.incoming.map((value, i) => value + data.outgoing[i]);
                    }
                    monthlyChartInstance.update();
                }

                if (topSendersChartInstance) {
                    topSendersChartInstance.data.labels = data.senderLabels.map(shortenAddress);
                    topSendersChartInstance.data.datasets[0].data = data.senderCounts;
                    topSendersChartInstance.fullSenderLabels = data.senderLabels;
                    topSendersChartInstance.update();
                }

                syncChartSelects(data);
                syncChartPaging(data);
                offerWindowsFor(data.granularity);
                showChartError(null);
            }

            let pendingSeriesRequest = null;

            function requestChartSeries() {
                if (!granularitySelect || !windowSelect || !sendersSelect) return;

                // A second change while one request is in flight makes the first answer stale,
                // and answers can come back out of order.
                if (pendingSeriesRequest) pendingSeriesRequest.abort();
                pendingSeriesRequest = new AbortController();

                const query = new URLSearchParams({
                    granularity: granularitySelect.value,
                    window: windowSelect.value,
                    senders: sendersSelect.value,
                    offset: String(chartOffset)
                });

                setChartsBusy(true);
                fetch(chartDataUrl + '?' + query.toString(), {
                    signal: pendingSeriesRequest.signal,
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                })
                    .then(response => response.ok ? response.json() : Promise.reject(new Error(response.status)))
                    .then(applyChartSeries)
                    .catch(error => {
                        if (error.name === 'AbortError') return;
                        showChartError(chartData && chartData.texts ? chartData.texts.loadFailed : '');
                    })
                    .finally(() => {
                        pendingSeriesRequest = null;
                        setChartsBusy(false);
                    });
            }

            if (granularitySelect && windowSelect && sendersSelect) {
                offerWindowsFor(granularitySelect.value);
                if (chartData) syncChartPaging(chartData);

                // A position means something else in another window, so changing the resolution
                // or the window goes back to the present rather than landing somewhere in
                // history without saying so.
                function requestFromPresent() {
                    chartOffset = 0;
                    requestChartSeries();
                }

                granularitySelect.addEventListener('change', function() {
                    offerWindowsFor(granularitySelect.value);
                    requestFromPresent();
                });
                windowSelect.addEventListener('change', requestFromPresent);
                sendersSelect.addEventListener('change', requestChartSeries);

                if (earlierButton) {
                    earlierButton.addEventListener('click', function() {
                        chartOffset -= 1;
                        requestChartSeries();
                    });
                }
                if (laterButton) {
                    laterButton.addEventListener('click', function() {
                        chartOffset = Math.min(chartOffset + 1, 0);
                        requestChartSeries();
                    });
                }
                if (nowButton) {
                    nowButton.addEventListener('click', requestFromPresent);
                }
            }

            // Leaving the page aborts a request in flight without running the handler that
            // clears the dimming, and the back button restores the DOM exactly as it was left,
            // dimmed charts included. Nothing else clears it, so this does.
            window.addEventListener('pageshow', function(e) {
                if (!e.persisted) return;
                pendingSeriesRequest = null;
                setChartsBusy(false);
                showChartError(null);
            });
            // Live-Update der Charts beim Theme-Wechsel
            const themeToggleBtn = document.getElementById('theme-toggle');
            if (themeToggleBtn) {
                themeToggleBtn.addEventListener('click', function() {
                    setTimeout(function() {
                        applyChartTheme(monthlyChartInstance);
                        applyChartTheme(topSendersChartInstance);
                    }, 0);
                });
            }

            @if (ViewBag.ActiveJobsCount != null && ViewBag.ActiveJobsCount > 0)
            {
                @:let refreshSeconds = 30;
                @:const refreshInterval = setInterval(function() {
                @:    refreshSeconds--;
                @:    if (refreshSeconds <= 0) {
                @:        clearInterval(refreshInterval);
                @:        location.reload();
                @:    }
                @:}, 1000);
            }
        });
    </script>
}