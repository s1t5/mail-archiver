@model MailArchiver.ViewModels.CreateMailcowInstanceViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<MailArchiver.SharedResource> L
@{ ViewData["Title"] = L["MailcowConnect"]; }
<div class="container">
    <h1>@L["MailcowConnect"]</h1>
    <p>@L["MailcowConnectHelp"]</p>
    <form asp-action="Create" method="post" autocomplete="off">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label">@L["AccountName"]</label><input asp-for="Name" class="form-control" /></div>
        <div class="mb-3"><label asp-for="ApiUrl" class="form-label">@L["MailcowUrl"]</label><input asp-for="ApiUrl" class="form-control" placeholder="https://mail.example.com" /></div>
        <div class="mb-3"><label asp-for="ApiKey" class="form-label">@L["MailcowApiKey"]</label><input asp-for="ApiKey" type="password" autocomplete="new-password" class="form-control" /></div>
        <div class="mb-3"><label asp-for="ImapHost" class="form-label">@L["MailcowImapHost"]</label><input asp-for="ImapHost" class="form-control" placeholder="mail.example.com" /></div>
        <div class="mb-3"><label asp-for="ImapPort" class="form-label">@L["MailcowImapPort"]</label><input asp-for="ImapPort" class="form-control" /></div>
        <button type="submit" class="btn btn-primary">@L["MailcowConnect"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@L["BackToList"]</a>
    </form>
</div>
