@model List<MailArchiver.Models.MailcowInstance>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MailArchiver.SharedResource> L
@{ ViewData["Title"] = L["MailcowInstances"]; }
<div class="container">
    <h1>@L["MailcowInstances"]</h1>
    <p>@L["MailcowIntroduction"]</p>
    <a asp-action="Create" class="btn btn-primary mb-3">@L["MailcowConnect"]</a>
    <a asp-controller="MailAccounts" asp-action="Index" class="btn btn-outline-secondary mb-3">@L["BackToList"]</a>
    <ul class="list-group">
        @foreach (var instance in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span><strong>@instance.Name</strong> <span class="text-muted">@instance.ApiUrl</span></span>
                <a asp-action="Mailboxes" asp-route-id="@instance.Id" class="btn btn-outline-primary">@L["MailcowManage"]</a>
            </li>
        }
    </ul>
</div>
